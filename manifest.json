{
    "manifest_version": 3,
    "name": "AI Detector Extension",
    "version": "1.0",
    "description": "Alerts when an AI-related website is opened.",
    "permissions": ["tabs", "activeTab", "alarms", "notifications"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["*://*.openai.com/*", "*://*.gemini.com/*", "*://*.bard.google.com/*"],
        "js": ["content.js"]
      }
    ],
    "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
  